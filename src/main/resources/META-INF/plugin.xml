<idea-plugin>
    <id>io.github.yluttsev.version-catalog-extractor</id>
    <name>Version Catalog Extractor</name>
    <vendor url="https://github.com/yluttsev">Yuri Luttsev</vendor>
    <resource-bundle>messages.CatalogExtractorBundle</resource-bundle>
    <description>
        <![CDATA[
    Detects literal dependency declarations in Gradle Kotlin and Groovy DSL files and offers
    a quick fix to move them to <code>gradle/libs.versions.toml</code>.<br>
    If the version catalog does not exist, the plugin creates it. If it already exists,
    the plugin reuses matching aliases or adds new library entries with version entries when needed.
        ]]>
    </description>

    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.intellij.groovy</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                language="kotlin"
                displayName="%inspection.kotlin.dsl.display.name"
                groupName="Gradle"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.yluttsev.catalogextractor.inspection.KotlinDslInspection"/>
        <localInspection
                language="Groovy"
                displayName="%inspection.groovy.dsl.display.name"
                groupName="Gradle"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.yluttsev.catalogextractor.inspection.GroovyDslInspection"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
